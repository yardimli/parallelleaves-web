APP_NAME="Parallel Leaves"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8018
PUBLIC_SITE_URL=https://paralleleaves.com
SUPPORT_EMAIL=support@parallelleaves.com

# In production set APP_ENV=production, APP_DEBUG=false,
# APP_URL=https://paralleleaves.com and SESSION_SECURE_COOKIE=true.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parallel_leaves
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Mailgun API transport. Use your verified sending domain and sending API key.
MAIL_MAILER=mailgun
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
MAIL_FROM_ADDRESS=noreply@paralleleaves.com
MAIL_FROM_NAME="Parallel Leaves"
# EU accounts use api.eu.mailgun.net. Never commit real credentials.
